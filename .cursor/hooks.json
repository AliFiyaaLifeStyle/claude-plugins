{
  "hooks": {
    "afterAgentResponse": [
      {
        "command": "python3 \"${CURSOR_PROJECT_DIR:-.}/.cursor/tenetx-guard.py\" --tenetx-response-timeout-seconds=75",
        "timeout": 90,
        "type": "command"
      }
    ],
    "afterAgentThought": [
      {
        "command": "python3 \"${CURSOR_PROJECT_DIR:-.}/.cursor/tenetx-guard.py\" --tenetx-response-timeout-seconds=75",
        "timeout": 90,
        "type": "command"
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 \"${CURSOR_PROJECT_DIR:-.}/.cursor/tenetx-guard.py\" --tenetx-response-timeout-seconds=75",
        "timeout": 90,
        "type": "command"
      }
    ],
    "afterMCPExecution": [
      {
        "command": "python3 \"${CURSOR_PROJECT_DIR:-.}/.cursor/tenetx-guard.py\" --tenetx-response-timeout-seconds=75",
        "timeout": 90,
        "type": "command"
      }
    ],
    "afterShellExecution": [
      {
        "command": "python3 \"${CURSOR_PROJECT_DIR:-.}/.cursor/tenetx-guard.py\" --tenetx-response-timeout-seconds=75",
        "timeout": 90,
        "type": "command"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "python3 \"${CURSOR_PROJECT_DIR:-.}/.cursor/tenetx-guard.py\" --tenetx-response-timeout-seconds=75",
        "timeout": 90,
        "type": "command"
      }
    ],
    "beforeReadFile": [
      {
        "command": "python3 \"${CURSOR_PROJECT_DIR:-.}/.cursor/tenetx-guard.py\" --tenetx-response-timeout-seconds=75",
        "timeout": 90,
        "type": "command"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 \"${CURSOR_PROJECT_DIR:-.}/.cursor/tenetx-guard.py\" --tenetx-response-timeout-seconds=75",
        "timeout": 90,
        "type": "command"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python3 \"${CURSOR_PROJECT_DIR:-.}/.cursor/tenetx-guard.py\" --tenetx-response-timeout-seconds=75",
        "failClosed": true,
        "timeout": 90,
        "type": "command"
      }
    ],
    "postToolUse": [
      {
        "command": "python3 \"${CURSOR_PROJECT_DIR:-.}/.cursor/tenetx-guard.py\" --tenetx-response-timeout-seconds=75",
        "matcher": ".*",
        "timeout": 90,
        "type": "command"
      }
    ],
    "postToolUseFailure": [
      {
        "command": "python3 \"${CURSOR_PROJECT_DIR:-.}/.cursor/tenetx-guard.py\" --tenetx-response-timeout-seconds=75",
        "matcher": ".*",
        "timeout": 90,
        "type": "command"
      }
    ],
    "preCompact": [
      {
        "command": "python3 \"${CURSOR_PROJECT_DIR:-.}/.cursor/tenetx-guard.py\" --tenetx-response-timeout-seconds=75",
        "timeout": 90,
        "type": "command"
      }
    ],
    "preToolUse": [
      {
        "command": "python3 \"${CURSOR_PROJECT_DIR:-.}/.cursor/tenetx-guard.py\" --tenetx-response-timeout-seconds=75",
        "failClosed": true,
        "matcher": ".*",
        "timeout": 90,
        "type": "command"
      }
    ],
    "sessionStart": [
      {
        "command": "python3 \"${CURSOR_PROJECT_DIR:-.}/.cursor/tenetx-guard.py\" --tenetx-response-timeout-seconds=75",
        "timeout": 90,
        "type": "command"
      }
    ],
    "stop": [
      {
        "command": "python3 \"${CURSOR_PROJECT_DIR:-.}/.cursor/tenetx-guard.py\" --tenetx-response-timeout-seconds=75",
        "timeout": 90,
        "type": "command"
      }
    ],
    "subagentStart": [
      {
        "command": "python3 \"${CURSOR_PROJECT_DIR:-.}/.cursor/tenetx-guard.py\" --tenetx-response-timeout-seconds=75",
        "timeout": 90,
        "type": "command"
      }
    ],
    "subagentStop": [
      {
        "command": "python3 \"${CURSOR_PROJECT_DIR:-.}/.cursor/tenetx-guard.py\" --tenetx-response-timeout-seconds=75",
        "timeout": 90,
        "type": "command"
      }
    ]
  },
  "version": 1
}
